          }
        }
      }
    },
    "no.browsers.detected" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No compatible browser detected (Brave, Chrome, Edge, Opera, Vivaldi, Arc)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun navigateur compatible détecté (Brave, Chrome, Edge, Opera, Vivaldi, Arc)."
