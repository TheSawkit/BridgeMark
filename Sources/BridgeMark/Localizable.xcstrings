{
  "sourceLanguage" : "fr",
  "strings" : {
    "app.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export Safari bookmarks to any browser. Safari is never modified."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte les favoris de Safari vers le navigateur de ton choix. Safari n'est jamais modifié."
          }
        }
      }
    },
    "error.browser.not.installed %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not installed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas installé."
          }
        }
      }
    },
    "error.browser.open %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is open. Close it before syncing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert. Ferme-le avant de synchroniser."
          }
        }
      }
    },
    "error.invalid.structure %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid structure for %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structure invalide pour %@."
          }
        }
      }
    },
    "error.permission.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access denied to Safari bookmarks. BridgeMark needs Full Disk Access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès refusé aux favoris Safari. BridgeMark a besoin de l'Accès complet au disque."
          }
        }
      }
    },
    "error.read.failure %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not read: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire : %@"
          }
        }
      }
    },
    "error.write.failure %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not write: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
