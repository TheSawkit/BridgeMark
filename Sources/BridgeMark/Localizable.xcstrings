    "overwrite.confirm.destructive" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overwrite"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écraser"
          }
        }
      }
    },
    "overwrite.confirm.message %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All bookmarks in %@'s bar will be deleted and replaced with Safari's. A timestamped backup is created automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les favoris dans la barre de %@ seront supprimés et remplacés par ceux de Safari. Un backup horodaté est créé automatiquement."
          }
        }
      }
    },
    "overwrite.confirm.title %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overwrite %@'s bookmarks?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écraser les favoris de %@ ?"
          }
        }
      }
    },
    "overwrite.warning %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overwrite mode deletes and replaces all bookmarks in %@'s bar. A timestamped backup is created automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Écraser supprime et remplace intégralement la barre de favoris de %@. Un backup automatique est créé avant l'opération."
          }
        }
      }
    },
